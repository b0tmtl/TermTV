<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/b0tmtl/termtv" version="0.1.0" viewmodes="maximized">
  <tizen:application id="TRMTVPLAYR.TermTV" package="TRMTVPLAYR" required_version="4.0"/>
  <tizen:profile name="tv-samsung"/>
  <name>TermTV</name>
  <description>Free, open-source IPTV player. Bring your own Xtream or M3U source.</description>
  <author href="https://github.com/b0tmtl/termtv">TermTV contributors</author>
  <license href="https://www.gnu.org/licenses/gpl-3.0.html">GPL-3.0</license>
  <content src="index.html"/>
  <icon src="icon.png"/>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>

  <!-- IPTV providers live on arbitrary hosts, often plain HTTP. -->
  <access origin="*" subdomains="true"/>
  <tizen:allow-navigation>*</tizen:allow-navigation>

  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
  <!-- Backup / restore to a USB drive. -->
  <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
  <tizen:privilege name="http://tizen.org/privilege/filesystem.write"/>

  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                 encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
